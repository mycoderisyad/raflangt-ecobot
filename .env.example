# EcoBot local configuration. Copy to .env and replace secrets before use.

ENVIRONMENT=development
APP_NAME=EcoBot
APP_VERSION=2.0.0
PORT=8000
TIMEZONE=Asia/Jakarta
VILLAGE_NAME=
VILLAGE_COORDINATES=
REGISTRATION_MODE=auto

# PostgreSQL must be installed and running locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecobot

# AI provider: gemini or openai
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=

# Optional live web search. Without a key, EcoBot still answers general questions.
# Quotas are enforced per Jakarta calendar day in PostgreSQL; 0 disables search.
BRAVE_SEARCH_API_KEY=
# `BRAVE_API_KEY` is also accepted (the name used in Brave's docs).
WEB_SEARCH_DAILY_LIMIT=30
WEB_SEARCH_USER_DAILY_LIMIT=3

# Telegram. Polling works on localhost; webhook mode needs a public HTTPS URL.
TELEGRAM_ENABLED=false
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-random-telegram-secret

# Optional email reports via Resend
RESEND_API_KEY=
EMAIL_FROM=EcoBot <noreply@ecobot.id>
EMAIL_TO=admin@example.com

# Telegram username lists, comma-separated, without @.
ADMIN_TELEGRAM_USERNAMES=
COORDINATOR_TELEGRAM_USERNAMES=

# Admin API credentials. Generate a random API_SECRET_KEY of at least 32 characters.
API_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_TTL_SECONDS=3600

# Comma-separated frontend origins; localhost Vite origins are defaults in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
